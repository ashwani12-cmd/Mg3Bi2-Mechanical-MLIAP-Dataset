# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 1.8189878144426
variable C2pos equal ${d2}
variable C2pos equal -3.68123457320325
variable C3pos equal ${d3}
variable C3pos equal -1.79827067665215
variable C4pos equal ${d4}
variable C4pos equal 16.6193230476131
variable C5pos equal ${d5}
variable C5pos equal -0.429972197881519
variable C6pos equal ${d6}
variable C6pos equal 0.174490794876104

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(2.9408785762211+${C1pos})
variable C14 equal 0.5*(2.9408785762211+1.8189878144426)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-1.1136358646205+${C2pos})
variable C24 equal 0.5*(-1.1136358646205+-3.68123457320325)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(1.5010021245696+${C3pos})
variable C34 equal 0.5*(1.5010021245696+-1.79827067665215)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
