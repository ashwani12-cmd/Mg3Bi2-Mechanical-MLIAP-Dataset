&CONTROL
   calculation      = 'relax'
   verbosity        = 'high'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   etot_conv_thr    = 1e-10
   forc_conv_thr    = 1e-10
   outdir           = './'
   disk_io          = 'none'
   pseudo_dir       = '/home/IITB/multiscale-mechanics/amit.k.singh/PP/LDA_ONCV/'
/
&SYSTEM
   ibrav            = 0
   nat              = 5
   ntyp             = 2
   ecutwfc          = 160.0
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'mp'
/
&ELECTRONS
   electron_maxstep = 400
   conv_thr         = 1e-08
   mixing_beta      = 0.3
/
&IONS
   ion_dynamics = 'bfgs'
/

