variable pyz1 equal -0.0271310329823118

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 36.0776758655957
variable C2neg equal ${d2}
variable C2neg equal 69.0433275378702
variable C3neg equal ${d3}
variable C3neg equal 24.1759119862479
