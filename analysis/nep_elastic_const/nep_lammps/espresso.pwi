&CONTROL
  calculation  = 'scf'
  restart_mode = 'from_scratch'
  prefix       = 'Mg3BiSb'
  outdir       = './out'
  pseudo_dir   = '/home/IITB/multiscale-mechanics/amit.k.singh/PP/LDA_ONCV'
  tprnfor      = .true.
  tstress      = .true.
  forc_conv_thr= 1.0d-8
/

&SYSTEM
  ibrav        = 0
  nat          = 5
  ntyp         = 3
  ecutwfc      = 180
  occupations  = 'smearing'
  smearing     = 'cold'
  degauss      = 0.008
/

&ELECTRONS
  conv_thr     = 1e-08
  mixing_beta  = 0.2
  mixing_mode  = 'local-TF'
  electron_maxstep = 200
/

&IONS
  ion_dynamics = 'bfgs'
/

K_POINTS automatic
12 12 8   0 0 0

