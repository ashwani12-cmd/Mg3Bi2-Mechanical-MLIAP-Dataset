&control
  calculation = 'bands',
  restart_mode = 'from_scratch',
  prefix = 'mg3bi2',
  outdir = './tmp/'
  tstress          = .true.
  tprnfor          = .true.
  etot_conv_thr    = 1e-10
  forc_conv_thr    = 1e-10
  pseudo_dir       = '/home/IITB/multiscale-mechanics/amit.k.singh/PP/LDA_ONCV/'   
  verbosity = 'high'
/

&system
  ibrav = 0,
  nat = 5,
  ntyp = 2,
  ecutwfc = 160,
  nbnd = 50,
  occupations = 'smearing',
  smearing = 'mp',
  degauss = 0.01
 /

&electrons
   electron_maxstep = 400
   conv_thr         = 1e-08
   mixing_beta      = 0.3
 /

